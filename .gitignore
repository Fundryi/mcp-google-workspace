# ---- Python artefacts --------------------------------------------------
__pycache__/
*.py[cod]
*.so
.mcp.json
claude.md
# ...but this fork's own CLAUDE.md is the rule file and belongs in the repo.
# Git matches the line above case-insensitively on Windows and macOS, so it
# swallowed CLAUDE.md silently. Private notes stay in CLAUDE.local.md, which
# the *.local.md rule further down still ignores.
!CLAUDE.md
.beads/*
.beads/issues.jsonl

# ---- Packaging ---------------------------------------------------------
*.egg-info/
build/
dist/

# ---- Environments & tooling -------------------------------------------
.env
.env.*
!.env.example
!.env.sample
.venv/
venv/
.idea/
.vscode/

# ---- macOS clutter -----------------------------------------------------
.DS_Store

# ---- Secrets -----------------------------------------------------------
client_secret.json
client_secrets.json
.mcpregistry_*_token

# ---- Logs --------------------------------------------------------------
mcp_server_debug.log

# ---- Local development files -------------------------------------------
/.credentials
/.claude
.serena/
Caddyfile
ecosystem.config.cjs

# ---- Agent instructions (not for distribution) -------------------------
.github/instructions/

# ---- Fork: local agent notes, never published ---------------------------
CLAUDE.local.md
*.local.md
WORKSPACE-MCP-PLAN.md

# ---- Fork: credentials and tokens, never commit a stray copy ------------
gcp-oauth.keys.json
client_secret*.json
accounts.json
credentials.json
allowed.txt
.credentials/

# ---- Fork: upstream check ----------------------------------------------
!.vscode/
!.vscode/tasks.json
UPSTREAM-UPDATE.md
*.local.json

.playwright-cli/